{
  "name": "sa-compare-structure",
  "tenant": "eval_sa_compare",
  "store": {
    "table": "embeddings_eval_sa_str",
    "dimension": 8
  },
  "pipelines": [
    {
      "key": "sa",
      "maxSegmentTokens": 300,
      "overlapTokens": 30,
      "modelKey": "eval-embedding",
      "storeKey": "eval-store",
      "strategy": "STRUCTURE_AWARE",
      "parentMaxTokens": 1200
    }
  ],
  "retrieval": {
    "topK": 3,
    "recallTopK": 5,
    "minScore": 0.0,
    "rerank": false,
    "rewrite": false
  },
  "metrics": {
    "k": [1, 3, 5],
    "diagnosticTopK": 10
  }
}
