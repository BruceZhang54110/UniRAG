<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.unirag.infrastructure.persistence.mapper.DocumentChunkMapper">

    <resultMap id="BaseResultMap" type="com.unirag.infrastructure.persistence.entity.DocumentChunk">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="documentId" column="document_id" jdbcType="BIGINT"/>
            <result property="documentVersionId" column="document_version_id" jdbcType="BIGINT"/>
            <result property="pipelineId" column="pipeline_id" jdbcType="BIGINT"/>
            <result property="seqIndex" column="seq_index" jdbcType="INTEGER"/>
            <result property="content" column="content" jdbcType="VARCHAR"/>
            <result property="tokenCount" column="token_count" jdbcType="INTEGER"/>
            <result property="embeddingId" column="embedding_id" jdbcType="VARCHAR"/>
            <result property="chunkLevel" column="chunk_level" jdbcType="VARCHAR"/>
            <result property="parentChunkId" column="parent_chunk_id" jdbcType="BIGINT"/>
            <result property="sectionPath" column="section_path" jdbcType="VARCHAR"/>
            <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,document_id,document_version_id,pipeline_id,
        seq_index,content,token_count,
        embedding_id,chunk_level,parent_chunk_id,section_path,created_at
    </sql>

    <select id="findByDocumentAndPipeline" resultMap="BaseResultMap">
        SELECT c.id, c.document_id, c.document_version_id, c.pipeline_id,
               c.seq_index, c.content, c.token_count, c.embedding_id, c.created_at
        FROM document_chunk c
        LEFT JOIN document_ingestion_version v ON v.id = c.document_version_id
        WHERE c.document_id = #{documentId} AND c.pipeline_id = #{pipelineId}
          AND (c.document_version_id IS NULL OR v.active = TRUE)
        ORDER BY c.seq_index ASC
    </select>

    <delete id="deleteByDocumentAndPipeline">
        DELETE FROM document_chunk
        WHERE document_id = #{documentId} AND pipeline_id = #{pipelineId}
    </delete>

    <resultMap id="ParentByChildMap" type="com.unirag.infrastructure.persistence.entity.DocumentChunk">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="documentId" column="document_id" jdbcType="BIGINT"/>
        <result property="documentVersionId" column="document_version_id" jdbcType="BIGINT"/>
        <result property="pipelineId" column="pipeline_id" jdbcType="BIGINT"/>
        <result property="seqIndex" column="seq_index" jdbcType="INTEGER"/>
        <result property="content" column="content" jdbcType="VARCHAR"/>
        <result property="tokenCount" column="token_count" jdbcType="INTEGER"/>
        <result property="embeddingId" column="embedding_id" jdbcType="VARCHAR"/>
        <result property="chunkLevel" column="chunk_level" jdbcType="VARCHAR"/>
        <result property="parentChunkId" column="parent_chunk_id" jdbcType="BIGINT"/>
        <result property="sectionPath" column="section_path" jdbcType="VARCHAR"/>
        <result property="childSeq" column="child_seq" jdbcType="INTEGER"/>
        <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 020 父子回填：子块命中 → parent_chunk_id 自引用 → 父块行；按租户作用域（document 归属）隔离 -->
    <select id="findParentsByChildSeqIndexes" resultMap="ParentByChildMap">
        SELECT p.id, p.document_id, p.document_version_id, p.pipeline_id,
               p.seq_index, p.content, p.token_count, p.embedding_id,
               p.chunk_level, p.parent_chunk_id, p.section_path, p.created_at,
               c.seq_index AS child_seq
        FROM document_chunk c
        JOIN document_chunk p ON p.id = c.parent_chunk_id
        WHERE c.document_id = #{documentId}
          AND c.pipeline_id = #{pipelineId}
          AND c.seq_index IN
        <foreach collection="childSeqIndexes" item="seq" open="(" separator="," close=")">
            #{seq}
        </foreach>
    </select>

    <!-- 021 章节存在性：租户作用域内 section_path 等值或子节前缀（starts_with 无通配符转义问题） -->
    <select id="countBySectionPrefix" resultType="long">
        SELECT count(*)
        FROM document_chunk dc
        JOIN document d ON d.id = dc.document_id
        JOIN tenant t ON t.id = d.tenant_id
        WHERE t.tenant_code = #{tenantCode}
          AND dc.section_path IS NOT NULL
          AND (dc.section_path = #{section} OR starts_with(dc.section_path, #{section} || '/'))
        <if test="documentId != null">
          AND dc.document_id = #{documentId}
        </if>
    </select>
</mapper>
