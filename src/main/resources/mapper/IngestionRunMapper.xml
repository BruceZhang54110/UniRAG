<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.unirag.infrastructure.persistence.mapper.IngestionRunMapper">

    <resultMap id="BaseResultMap" type="com.unirag.infrastructure.persistence.entity.IngestionRun">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="documentId" column="document_id" jdbcType="BIGINT"/>
            <result property="documentVersionId" column="document_version_id" jdbcType="BIGINT"/>
            <result property="jobId" column="job_id" jdbcType="BIGINT"/>
            <result property="pipelineId" column="pipeline_id" jdbcType="BIGINT"/>
            <result property="status" column="status" jdbcType="VARCHAR"/>
            <result property="chunkCount" column="chunk_count" jdbcType="INTEGER"/>
            <result property="errorMessage" column="error_message" jdbcType="VARCHAR"/>
            <result property="startedAt" column="started_at" jdbcType="TIMESTAMP"/>
            <result property="finishedAt" column="finished_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,document_id,document_version_id,job_id,pipeline_id,
        status,chunk_count,error_message,
        started_at,finished_at
    </sql>

    <select id="findByDocumentId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM ingestion_run
        WHERE document_id = #{documentId}
        ORDER BY id ASC
    </select>

    <select id="findUnfinishedByDocumentIds" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM ingestion_run
        WHERE finished_at IS NULL
        <if test="documentIds != null and documentIds.size() > 0">
            AND document_id IN
            <foreach collection="documentIds" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
    </select>
</mapper>
