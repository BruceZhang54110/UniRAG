<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.unirag.infrastructure.mp.mapper.DocumentMapper">

    <resultMap id="BaseResultMap" type="com.unirag.infrastructure.mp.entity.Document">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="tenantId" column="tenant_id" jdbcType="BIGINT"/>
            <result property="docName" column="doc_name" jdbcType="VARCHAR"/>
            <result property="title" column="title" jdbcType="VARCHAR"/>
            <result property="contentFingerprint" column="content_fingerprint" jdbcType="CHAR"/>
            <result property="status" column="status" jdbcType="VARCHAR"/>
            <result property="chunkCount" column="chunk_count" jdbcType="INTEGER"/>
            <result property="version" column="version" jdbcType="INTEGER"/>
            <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
            <result property="updatedAt" column="updated_at" jdbcType="TIMESTAMP"/>
            <result property="deleted" column="deleted" jdbcType="BOOLEAN"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,tenant_id,doc_name,
        title,content_fingerprint,status,
        chunk_count,version,created_at,
        updated_at,deleted
    </sql>

    <select id="findByTenantAndName" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM document
        WHERE tenant_id = #{tenantId} AND doc_name = #{docName} AND deleted = FALSE
    </select>
</mapper>
