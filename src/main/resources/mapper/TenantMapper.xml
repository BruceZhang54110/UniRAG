<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.unirag.infrastructure.persistence.mapper.TenantMapper">

    <resultMap id="BaseResultMap" type="com.unirag.infrastructure.persistence.entity.Tenant">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="tenant_code" column="tenant_code" jdbcType="VARCHAR"/>
            <result property="name" column="name" jdbcType="VARCHAR"/>
            <result property="enabled" column="enabled" jdbcType="BOOLEAN"/>
            <result property="created_at" column="created_at" jdbcType="TIMESTAMP"/>
            <result property="updated_at" column="updated_at" jdbcType="TIMESTAMP"/>
            <result property="deleted" column="deleted" jdbcType="BOOLEAN"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,tenant_code,name,
        enabled,created_at,updated_at,
        deleted
    </sql>

    <select id="findByCode" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM tenant
        WHERE tenant_code = #{tenantCode} AND deleted = FALSE
    </select>

    <select id="findEnabledById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM tenant
        WHERE id = #{tenantId} AND enabled = TRUE AND deleted = FALSE
    </select>
</mapper>
